<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:strings="clr-namespace:GestorFinanzas.Strings"
             x:Class="GestorFinanzas.PlanAhorroPage"
             Title="{Binding [PlanAhorro_Titulo], Source={x:Static strings:Tr.Instance}}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15" Spacing="14">

                <!-- Aún no tiene meta -->
                <VerticalStackLayout x:Name="PanelSinMeta" Spacing="8" IsVisible="False" Margin="0,20,0,0">
                    <Label Text="{Binding [PlanAhorro_SinMetaTitulo], Source={x:Static strings:Tr.Instance}}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding [PlanAhorro_SinMetaDesc], Source={x:Static strings:Tr.Instance}}" FontSize="13" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Meta activa -->
                <VerticalStackLayout x:Name="PanelConMeta" Spacing="14" IsVisible="False">

                    <Border BackgroundColor="{StaticResource Primary}" Padding="16" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="LblNombreMeta" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            <Label x:Name="LblMontoMeta" TextColor="White" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="14" StrokeShape="RoundRectangle 12" Stroke="LightGray">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="LblMontoPorPeriodo" FontSize="15" FontAttributes="Bold" />
                            <Label x:Name="LblAhorroReal" FontSize="14" />
                            <ProgressBar x:Name="ProgressMeta" ProgressColor="{StaticResource Primary}" />
                            <Label x:Name="LblEstado" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <Button x:Name="BtnRegistrarAporte" Text="{Binding [PlanAhorro_RegistrarAporte], Source={x:Static strings:Tr.Instance}}" BackgroundColor="#00B894" TextColor="White" Clicked="OnRegistrarAporteClicked" />

                    <Button x:Name="BtnBorrarMeta" Text="{Binding [PlanAhorro_BorrarMeta], Source={x:Static strings:Tr.Instance}}" BackgroundColor="Transparent" TextColor="Red" Clicked="OnBorrarMetaClicked" />
                </VerticalStackLayout>

                <Button x:Name="BtnCrearEditarMeta" Text="{Binding [PlanAhorro_CrearMeta], Source={x:Static strings:Tr.Instance}}" Clicked="OnCrearOEditarMetaClicked" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Banner de anuncios -->
        <Grid Grid.Row="1" BackgroundColor="LightGray" HeightRequest="60" HorizontalOptions="Fill">
            <admob:BannerAd x:Name="BannerPlanAhorro"
                             AdUnitId="ca-app-pub-4227427045418783/7265940366"
                             AdSize="Banner"
                             WidthRequest="320"
                             HeightRequest="50"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>